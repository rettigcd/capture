<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to show the live preview and take photographs. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Required only while voice triggering is enabled; requested at runtime,
         never at install time. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- MediaStore + scoped storage (minSdk 29) is used for saving photographs,
         so no WRITE_EXTERNAL_STORAGE / READ_MEDIA_IMAGES permission is required. -->

    <!-- Normal (install-time) permission: the short capture-success pulse. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Android 11+ package visibility: lets SpeechRecognizer.isRecognitionAvailable()
         and RecognizerIntent resolution see installed recognition services/activities. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".CaptureApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Capture">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Capture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Exporting the encryption key backup file (internal storage, KeyPair.kkey) via the
            system share sheet needs a content:// Uri - a raw file:// Uri can't be shared to
            another app on modern Android. FileProvider is the standard, permission-scoped way to
            mint one for a file this app already owns; see res/xml/file_paths.xml for the exact
            path it's allowed to expose (files-dir only) and security/data/KeyFileSharing.kt for
            the Intent this backs.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
